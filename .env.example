# PostgreSQL (local, Supabase, or Neon). Leave unset to use SQLite for quick dev.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/org_portal

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=

# resend | ses
EMAIL_PROVIDER=ses   # ses | resend
EMAIL_FROM=Org Portal <no-reply@yourdomain.org>
EMAIL_BATCH_SIZE=50
RESEND_API_KEY=

CONSECUTIVE_ABSENCE_LIMIT=3
WARNING_ABSENCE_THRESHOLD=2
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
SESSION_HOURS=8
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
COOKIE_SECURE=false        # set true behind HTTPS
DEV_PRINT_LOGIN_CODES=false # dev only: print codes in server log instead of emailing

# DEMO ONLY: shows the code on the login page (leaks which emails exist). Keep false in production.
DEMO_SHOW_LOGIN_CODE=false
